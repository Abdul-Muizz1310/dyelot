# The origin the end-to-end server and the unit tests assume. Nothing in src/ reads this variable:
# canonical links, the sitemap and share cards take their origin from SITE.url in
# src/lib/site/config.ts. playwright.config.ts sets it for the e2e server, tests/setup.ts defaults
# it for Vitest, and CI sets it for the build. The app runs without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# The origin the end-to-end server and the unit tests assume. Nothing in src/ reads this variable:
# canonical links, the sitemap and share cards take their origin from SITE.url in
# src/lib/site/config.ts. playwright.config.ts sets it for the e2e server, tests/setup.ts defaults
# it for Vitest, and CI sets it for the build. The app runs without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# The AI layer's server environment (docs/specs/04-ai.md, R4-20 and section 11.4), read by
# readAiEnv in src/server/ai/env.ts in this order. Each value is stripped of a leading byte-order
# mark and edge white space; an empty value is unset. Never commit a real key or secret here.

# OpenRouter's server key: 20 to 200 printable ASCII characters. Vercel Production only.
OPENROUTER_API_KEY=
# The cap cookie's HMAC secret: base64 or base64url of at least 32 bytes. Vercel Production only.
DYELOT_COOKIE_SECRET=
# The free requests left in the shared pool for the rest of the portfolio: 0 to 1000 (R4-17).
DYELOT_AI_RESERVE=35
# Unset is https://openrouter.ai/api/v1; the tests point it at the local mock (R4-58).
OPENROUTER_BASE_URL=
# The text tiers, then the vision tiers (R4-13), each a free slug; an empty one skips its tier.
OPENROUTER_MODEL_PRIMARY=google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL_FAST=xingchen-agi/xing4.0-29b-a4b:free
OPENROUTER_MODEL_FALLBACK=dots-studio/dots-3-note-preview:free
OPENROUTER_VISION_MODEL_1=dots-studio/dots-3-note-preview:free
OPENROUTER_VISION_MODEL_2=google/gemma-4-26b-a4b-it:free
# Set to nvidia/nemotron-3.5-super-vl:free once its live smoke passes (R4-61).
OPENROUTER_VISION_MODEL_3=

# Tracing (R4-52): on only with all three Langfuse variables, set with the owner's approval; with
# all three empty, tracing is off. The base URL for Langfuse Cloud US is
# https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# The trace environment: lowercase letters, digits, "_" or "-", not starting "langfuse". Unset is
# production.
APP_ENV=

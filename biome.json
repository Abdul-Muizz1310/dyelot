{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}",
      "*.ts",
      "scripts/*.mjs",
      "src/export/checker/*.mjs"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zod": "Import z from src/spec/zod.ts, which turns on jitless mode for the CSP."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/features/**", "src/app/**", "src/components/**", "src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import z from src/spec/zod.ts, which turns on jitless mode for the CSP."
                },
                "patterns": [
                  {
                    "group": ["@/engine/**", "@/spec/**", "**/engine/**", "**/spec/**"],
                    "message": "Import the engine from @/engine and the spec from @/spec, never from a file inside them."
                  },
                  {
                    "group": [
                      "@/export/**",
                      "@/import/**",
                      "@/ai/**",
                      "../**/export/**",
                      "../**/import/**",
                      "../**/ai/**"
                    ],
                    "message": "Load the export, import and AI cores only through import(\"@/export\"), import(\"@/import\") or import(\"@/ai\"), never from a file inside them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/spec/zod.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } }
}
